@model MotiZone.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h3 class="text-center text-primary mb-4">Welcome Back</h3>
                        <form asp-action="Login" method="post" novalidate>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                                <input asp-for="Email" class="form-control rounded-pill" placeholder="Enter your email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <input asp-for="Password" type="password" class="form-control rounded-pill" placeholder="Enter your password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary rounded-pill">Login</button>
                            </div>
                        </form>

                        <div class="text-center mt-3">
                            <p class="small text-muted">Don't have an account?
                                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                            </p>
                            <p class="small text-muted">
                                <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">Forgot your password?</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
