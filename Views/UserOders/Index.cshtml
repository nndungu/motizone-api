@model List<MotiZone.Models.Order>

<h2>My Orders</h2>

@foreach (var order in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Order #@order.Id</h5>
            <p>Status: <strong>@order.Status</strong></p>
            <p>Total: @order.TotalAmount.ToString("C")</p>
            <a href="@Url.Action("Details", "UserOrders", new { id = order.Id })" class="btn btn-sm btn-outline-primary">View Details</a>
        </div>
    </div>
}
