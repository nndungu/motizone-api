@model IEnumerable<MotiZone.Models.Order>

<h2>All Orders (Admin View)</h2>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Order ID</th>
        <th>User Email</th>
        <th>Date</th>
        <th>Total</th>
        <th>Details</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Id</td>
            <td>@order.User?.Email</td>
            <td>@order.OrderDate.ToLocalTime()</td>
            <td>KES @order.TotalAmount</td>
            <td>
                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">View</a>
            </td>
            <form method="post" asp-action="UpdateStatus">
                <input type="hidden" name="id" value="@order.Id" />
                <select name="status" onchange="this.form.submit()">
                    @foreach (var val in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@val" selected="@(val.Equals(order.Status) ? "selected" : "")">@val</option>
                    }
                </select>
            </form>
            <form method="get" class="mb-4">
                <input type="text" name="email" placeholder="User email" />
                <input type="date" name="start" />
                <input type="date" name="end" />
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </tr>
    }
    </tbody>
</table>
