@model MotiZone.Models.Order

<h2>Order Receipt - #@Model.Id</h2>
<p><strong>Date:</strong> @Model.OrderDate.ToLocalTime()</p>
<p><strong>Total:</strong> KES @Model.TotalAmount</p>

<table class="table">
    <thead>
    <tr>
        <th>Item</th>
        <th>Type</th>
        <th>Qty</th>
        <th>Price (KES)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>
                @item.Vehicle?.Name ?? item.Part?.Name ?? item.Customization?.Name
            </td>
            <td>
                @(
                item.VehicleId != null ? "Vehicle" :
                item.PartId != null ? "Part" :
                item.CustomizationId != null ? "Customization" : "Unknown"
                )
            </td>
            <td>@item.Quantity</td>
            <td>@item.Price</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Orders</a>

@*
@model List<MotiZone.Models.Order>
@{
    ViewData["Title"] = "Your Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model == null || !Model.Any())
{
    <p>You have no orders yet.</p>
}
else
{
    foreach (var order in Model)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>Order ID:</strong> @order.Id |
                <strong>Date:</strong> @order.OrderDate.ToString("g")
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var item in order.Items)
                    {
                        <li class="list-group-item">
                            @if (item.Vehicle != null)
                            {
                                <div>
                                    <strong>Vehicle:</strong> @item.Vehicle.Make @item.Vehicle.Model
                                    (@item.Price.ToString("C")) x @item.Quantity
                                </div>
                            }
                            else if (item.Part != null)
                            {
                                <div>
                                    <strong>Part:</strong> @item.Part.Name
                                    (@item.Price.ToString("C")) x @item.Quantity
                                </div>
                            }
                        </li>
                    }
                </ul>
                <p class="fw-bold mt-3">Total: @order.TotalAmount.ToString("C")</p>
            </div>
        </div>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
}
*@
