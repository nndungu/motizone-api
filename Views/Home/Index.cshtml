@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Carousel Section -->
<div id="homeCarousel" class="carousel slide carousel-fade mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/shop/shop.jpg" class="d-block w-100" alt="Drive Your Dream" />
            <div class="carousel-caption d-none d-md-block">
                <h5 class="text-shadow">Drive Your Dream</h5>
                <p class="text-shadow">Discover the latest vehicles at unbeatable prices.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Explore Shop</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/vehicles/car-placeholder.jpg" class="d-block w-100" alt="Reliable Rentals" />
            <div class="carousel-caption d-none d-md-block">
                <h5 class="text-shadow">Reliable Rentals</h5>
                <p class="text-shadow">Book your next ride with ease and flexibility.</p>
                <a asp-controller="Rentals" asp-action="Index" class="btn btn-light">View Rentals</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/rentals/rental-car.jpg" class="d-block w-100" alt="Customize Your Ride" />
            <div class="carousel-caption d-none d-md-block">
                <h5 class="text-shadow">Custom. Unique. Yours.</h5>
                <p class="text-shadow">Add your personality with our customization services.</p>
                <a asp-controller="Customization" asp-action="Index" class="btn btn-success">Customize Now</a>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- Welcome Section -->
<section class="py-5 bg-light text-center">
    <div class="container">
        <img src="~/images/moti.png" class="mb-3" width="80" alt="MotiZone Logo" />
        <h1 class="display-5 fw-bold text-primary">Welcome to Motizone</h1>
        <p class="lead text-secondary">Your ultimate destination for vehicle rentals and auto services.</p>
        <div class="mt-4">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-lg me-2">Explore Shop</a>
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-outline-dark btn-lg me-2">View Vehicles</a>
            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-success btn-lg">Checkout</a>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="container py-5">
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <img src="~/images/vehicles/car-placeholder.jpg" class="img-fluid rounded shadow-sm mb-3" />
            <h5 class="fw-bold">Vehicles</h5>
            <p class="text-muted">Browse a variety of cars and rentals available at competitive rates.</p>
        </div>
        <div class="col-md-4 mb-4">
            <img src="~/images/rentals/rental-car.jpg" class="img-fluid rounded shadow-sm mb-3" />
            <h5 class="fw-bold">Parts & Services</h5>
            <p class="text-muted">Need a tune-up or replacement? We’ve got quality services you can trust.</p>
        </div>
        <div class="col-md-4 mb-4">
            <img src="~/images/vehicles/car-placeholder.jpg" class="img-fluid rounded shadow-sm mb-3" />
            <h5 class="fw-bold">Quick Checkout</h5>
            <p class="text-muted">Ready to roll? Checkout your selected items and rentals quickly and securely.</p>
        </div>
    </div>
</section>














