@model MotiZone.Models.Rental
@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"]!.ToString() == "Edit" ? "Edit Rental" : "Add New Rental";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container">
        <h2 class="text-primary mb-4">@ViewData["Title"]</h2>

        <form asp-action="@ViewContext.RouteData.Values["action"]" method="post" class="row g-3">
            <div class="col-md-6">
                <label asp-for="VehicleName" class="form-label">Vehicle Name</label>
                <input asp-for="VehicleName" class="form-control" />
                <span asp-validation-for="VehicleName" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="EndDate" class="form-label">End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="TotalCost" class="form-label">Total Cost</label>
                <input asp-for="TotalCost" class="form-control" />
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">@ViewData["Title"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</section>
