@model List<MotiZone.Models.ViewModels.CartViewModel>
@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-4">Your Shopping Cart</h2>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                Your cart is currently empty.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover shadow-sm bg-white rounded-3">
                    <thead class="table-primary">
                    <tr>
                        <th class="text-start">Item</th>
                        <th class="text-start">Type</th>
                        <th class="text-end">Price</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.Name</td>
                            <td class="align-middle">@item.Type</td>
                            <td class="align-middle text-end text-success fw-semibold">
                                @item.Price.ToString("C")
                            </td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post" asp-controller="Cart">
                                    <input type="hidden" name="id" value="@item.Id"/>
                                    <button class="btn btn-sm btn-outline-danger" type="submit"></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="d-flex justify-content-end mt-4">
                    <form asp-controller="Cart" asp-action="Clear" method="post">
                        <button class="btn btn-outline-danger" type="submit"> Clear Cart</button>
                    </form>
                    <form asp-controller="Payment" asp-action="Checkout" method="get">
                        <input type="hidden" name="amount" value="@Model.Sum(item => item.Price)" />
                        <button type="submit" class="btn btn-primary btn-lg">Pay with Stripe</button>
                    </form>
                    <form method="post" asp-controller="Cart" asp-action="Checkout">
                        <label for="method">Choose payment method:</label>
                        <select name="method" id="method">
                            <a asp-controller="Payments" asp-action="StripeCheckout" class="btn btn-primary btn-lg ms-3 rounded-pill">Pay with Stripe</a>
                            <option value="stripe">Stripe</option>
                            <option value="mpesa">M-Pesa</option>
                        </select>
                        @*<input type="hidden" name="amount" value="@Model.TotalAmount" />*@
                        <button type="submit" class="btn btn-success">Pay Now</button>
                    </form>

                    <form asp-controller="Cart" asp-action="Checkout" method="post">
                        <button class="btn btn-success btn-lg rounded-pill" type="submit">
                            Proceed to Checkout
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>
