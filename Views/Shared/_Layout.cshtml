@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager

@{
    var currentPath = Context.Request.Path;
    var isAdmin = User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MotiZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MotiZone.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                <img src="~/images/moti.png" alt="MotiZone" width="30" height="30" class="d-inline-block align-text-top" />
                Motizone
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link @(currentPath == "/" ? "fw-bold" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWithSegments("/Shop") ? "fw-bold" : "")" asp-controller="Shop" asp-action="Index">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWithSegments("/Cart") ? "fw-bold" : "")" asp-controller="Cart" asp-action="Index">Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-success btn-sm ms-2" asp-controller="Orders" asp-action="Index">Checkout</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWithSegments("/Vehicles") ? "fw-bold" : "")" asp-controller="Vehicles" asp-action="Index">Vehicles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWithSegments("/Rentals") ? "fw-bold" : "")" asp-controller="Rentals" asp-action="Index">Rentals</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWithSegments("/Services") ? "fw-bold" : "")" asp-controller="Parts" asp-action="Index">Parts</a>
                    </li>

                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-bs-toggle="dropdown">
                                Admin
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="AdminVehicles" asp-action="Index">Manage Vehicles</a></li>
                                <li><a class="dropdown-item" asp-controller="AdminRentals" asp-action="Index">Manage Rentals</a></li>
                                <li><a class="dropdown-item" asp-controller="AdminServices" asp-action="Index">Manage Parts</a></li>
                                <li><a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">Manage Users</a></li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Order" asp-action="All">All Orders</a>
                                </li>
                            </ul>
                        </li>
                    }

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWithSegments("/Account/Login") ? "fw-bold" : "")" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWithSegments("/Account/Register") ? "fw-bold" : "")" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="container py-4">
    @RenderBody()
</main>

@*<footer class="bg-light border-top text-muted text-center py-3">
    <div class="container">
        &copy; 2025 - MotiZone - All rights reserved |
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>*@

<footer class="bg-light border-top text-muted text-center py-3">
    <div class="container">
        <div class="row">
            <!-- Logo and Description -->
            <div class="col-md-4 mb-4">
                <h4 class="text-warning fw-bold">MotiZone</h4>
                <p class="small text-muted">East Africa’s trusted platform for vehicle rentals, parts & upgrades. Drive smarter with MotiZone.</p>
            </div>

            <!-- Quick Links -->
            @*<div class="col-md-4 mb-4">
                <h5 class="text-light">Quick Links</h5>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a></li>
                    <li><a asp-controller="Vehicles" asp-action="Index" class="text-muted text-decoration-none">Vehicles</a></li>
                    <li><a asp-controller="Parts" asp-action="Index" class="text-muted text-decoration-none">Parts</a></li>
                    <li><a asp-controller="Rentals" asp-action="Index" class="text-muted text-decoration-none">Rentals</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a></li>
                </ul>
            </div>*@

            <!-- Contact + Socials -->
            <div class="col-md-4 mb-4">
                <h5 class="text-light">Contact Us</h5>
                <p class="small text-muted mb-1">📍 Nairobi, Kenya</p>
                <p class="small text-muted mb-1">📞 +254 712 345 678</p>
                <p class="small text-muted mb-3">✉️ support@motizone.com</p>
                <div>
                    <a href="#" class="text-warning me-3"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-warning me-3"><i class="bi bi-twitter-x fs-5"></i></a>
                    <a href="#" class="text-warning me-3"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-warning"><i class="bi bi-whatsapp fs-5"></i></a>
                </div>
            </div>
        </div>
        <hr class="border-secondary" />
        <div class="text-center text-muted small">
            &copy; 2025 MotiZone. All rights reserved.
        </div>
    </div>
</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>









