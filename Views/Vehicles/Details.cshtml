@model MotiZone.Models.Vehicle

@{
    ViewData["Title"] = $"{Model.Make} {Model.Model}";
    Layout = "../Shared/_Layout";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <div class="row">
        <div class="col-md-6">
            <img src="~/images/vehicles/car-placeholder.jpg" class="img-fluid" alt="@Model.Model" />
        </div>
        <div class="col-md-6">
            <h3 class="text-success">@Model.Price.ToString("C")</h3>
            <p><strong>Year:</strong> @Model.Year</p>
            <p><strong>Make:</strong> @Model.Make</p>
            <p><strong>Model:</strong> @Model.Model</p>
            <a class="btn btn-primary"
               asp-controller="Cart"
               asp-action="AddVehicle"
               asp-route-id="@Model.Id">
                Add to Cart
            </a>
        </div>
    </div>
</div>