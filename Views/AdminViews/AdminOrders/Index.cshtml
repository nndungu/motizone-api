@model IEnumerable<MotiZone.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">
                Manage Orders
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <p>No orders found.</p>
                }
                else
                {
                    <table class="table table-hover">
                        <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.User?.Email</td>
                                <td>@order.OrderDate.ToString("g")</td>
                                <td>@order.TotalAmount.ToString("C")</td>
                                <td>@order.Status</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">View</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>
