@model List<Order>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>User</th>
        <th>Total</th>
        <th>Method</th>
        <th>Status</th>
        <th>Date</th>
        <th>Txn ID</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Id</td>
            <td>@order.User?.Email</td>
            <td>KES @order.TotalAmount</td>
            <td>@order.PaymentMethod</td>
            <td>@order.OrderDate.ToShortDateString()</td>
            <td>@order.TransactionId</td>
        </tr>
    }
    </tbody>
</table>
