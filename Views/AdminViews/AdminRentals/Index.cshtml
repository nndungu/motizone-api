@model IEnumerable<MotiZone.Models.Rental>
@{
    ViewData["Title"] = "Manage Rentals";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container">
        <h2 class="text-primary fw-bold mb-4">Manage Rentals</h2>

        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-light">
            <tr>
                <th>Vehicle</th>
                <th>Customer</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var rental in Model)
            {
                <tr>
                    <td>@rental.Vehicle?.Model</td>
                    <td>@rental.User?.UserName</td>
                    <td>@rental.StartDate.ToShortDateString()</td>
                    <td>@rental.EndDate.ToShortDateString()</td>
                    <td>
                        <span class="badge bg-@((rental.IsActive) ? "success" : "secondary")">@((rental.IsActive) ? "Active" : "Completed")</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-info">Details</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="text-end mt-3">
            <a asp-action="Create" class="btn btn-success rounded-pill">+ Add Rental</a>
        </div>
    </div>
</section>
