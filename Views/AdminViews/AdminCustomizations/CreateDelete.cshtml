@model MotiZone.Models.Customization

@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"].ToString() == "Create" ? "Add Customization" : "Edit Customization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">
                @ViewData["Title"]
            </div>
            <div class="card-body">
                <form asp-action="@ViewContext.RouteData.Values["action"]">
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-semibold"></label>
                        <input asp-for="Type" class="form-control" />
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-semibold"></label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</section>
