@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center text-primary fw-bold mb-4">Admin Dashboard</h2>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="card shadow-sm text-center p-3">
                    <h5 class="text-muted">Users</h5>
                    <h3 class="text-primary">@(ViewBag.UserCount ?? 0)</h3>
                    <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-primary mt-2">Manage</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center p-3">
                    <h5 class="text-muted">Orders</h5>
                    <h3 class="text-primary">@(ViewBag.OrderCount ?? 0)</h3>
                    <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-outline-primary mt-2">Manage</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center p-3">
                    <h5 class="text-muted">Rentals</h5>
                    <h3 class="text-primary">@(ViewBag.RentalCount ?? 0)</h3>
                    <a asp-controller="AdminRentals" asp-action="Index" class="btn btn-outline-primary mt-2">Manage</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center p-3">
                    <h5 class="text-muted">Parts</h5>
                    <h3 class="text-primary">@(ViewBag.PartCount ?? 0)</h3>
                    <a asp-controller="AdminServices" asp-action="Index" class="btn btn-outline-primary mt-2">Manage</a>
                </div>
            </div>
        </div>
    </div>
</section>
