@model MotiZone.Models.Part
@{
    ViewData["Title"] = "Part Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole("Admin");
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/parts/part-placeholder.jpg" class="img-fluid rounded shadow-sm" alt="@Model.Name" />
            </div>
            <div class="col-md-6">
                <h2 class="text-primary fw-bold">@Model.Name</h2>
                <p class="text-muted">@Model.Description</p>
                <h4 class="text-success">@Model.Price.ToString("C")</h4>

                @if (isAdmin)
                {
                    <a class="btn btn-outline-primary mt-3" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                }

                <a class="btn btn-outline-secondary mt-3 ms-2" asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</section>